# -*- coding: utf-8 -*-
import os, re, html as _html, logging
from odoo import models
_logger = logging.getLogger(__name__)
try:
    from odoo.tools import html_sanitize as _html_sanitize
except Exception:
    _html_sanitize = None
try:
    import requests
except Exception:
    requests = None
BASE = "https://apiv2.infortisa.com"
HDR  = "Authorization-Token"

def _fetch_full_desc_infortisa(sku, app_key, base=BASE):
    if not (requests and sku and app_key): return None
    headers = {HDR: app_key}
    for p in (f"/api/Product/GetProductBySku?Sku={sku}",
              f"/api/Product/GetProductByPartnumber?partnumber={sku}"):
        try:
            r = requests.get(base + p, headers=headers, timeout=12)
            if not r.ok: continue
            d = r.json() or {}
            fd = d.get("FullDescription") or d.get("fulldescription")
            sd = d.get("ShortDescription") or d.get("shortdescription") or ""
            raw = (fd or sd or "").strip()
            if raw: return _html.unescape(raw)
        except Exception as e:
            _logger.debug("Infortisa REST desc error on %s: %s", p, e)
    return None

def _norm_html_for_cmp(s):
    if s is None: return ""
    t = s
    try:
        if _html_sanitize: t = _html_sanitize(t)
    except Exception: pass
    t = _html.unescape(t).replace("\r\n","\n").replace("\r","\n").replace("<br />","<br/>")
    t = re.sub(r">\s+<", "><", t)
    t = re.sub(r"\s+", " ", t).strip()
    return t

class VendorCatalogInfortisaRestDesc(models.Model):
    _inherit = "vendor.catalog.config"

    def _get_infortisa_app_key(self):
        ICP = self.env['ir.config_parameter'].sudo()
        return (
            os.getenv("INFORTISA_APP_KEY")
            or (self.auth_token or "")
            or ICP.get_param('vendor_catalog_import.infortisa_app_key')
            or ICP.get_param('infortisa.app_key')
            or ""
        ).strip()

    def _upsert_product(self, item):
        res = super()._upsert_product(item)
        tmpl = res[0] if isinstance(res, (list, tuple)) else res
        if not tmpl: return res
        PT = self.env["product.template"].sudo()
        if "description_ecommerce" not in PT._fields: return res
        if (self.env.context or {}).get("skip_infortisa_rest"): return res

        sku = (item.get("sku") or item.get("default_code") or tmpl.default_code or "").strip()
        if not sku: return res

        app_key = self._get_infortisa_app_key()
        if not app_key:
            _logger.info("Infortisa REST: sin API key; se deja la descripción del feed.")
            return res

        remote_html = _fetch_full_desc_infortisa(sku, app_key)
        if not remote_html: return res

        current = (tmpl.description_ecommerce or "")
        if _norm_html_for_cmp(current) == _norm_html_for_cmp(remote_html):
            return res

        vals = {"description_ecommerce": remote_html.replace("<br />","<br/>")}
        for f in ('description_sale','website_description','website_short_description'):
            if f in PT._fields: vals[f] = False
        try:
            tmpl.with_context(lang=None).sudo().write(vals)
            _logger.info("Infortisa: description_ecommerce actualizada (sku=%s, old_len=%s, new_len=%s)",
                         sku, len(current or ""), len(remote_html or ""))
        except Exception as e:
            _logger.warning("No se pudo escribir description_ecommerce (sku=%s): %s", sku, e)
        return res
