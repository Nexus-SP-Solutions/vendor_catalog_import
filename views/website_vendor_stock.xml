<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Mostrar stock inmediatamente después del H1 (encima de la descripción corta) -->
  <template id="product_vendor_stock" inherit_id="website_sale.product"
            name="Mostrar stock debajo del H1" priority="90">
    <!-- Buscamos el H1 por varias rutas para que sea robusto en Odoo 18 -->
    <xpath expr="//h1[@itemprop='name'] | //div[@id='product_details']//h1 | //h1" position="after">
      <t t-if="'x_vendor_stock' in product._fields">
        <div class="o_vendor_stock fs-5 mb-2">
          <span class="me-1"><i class="fa fa-truck"/></span>
          Stock: <strong t-esc="product.x_vendor_stock or 0"/>
        </div>
      </t>
    </xpath>
  </template>
</odoo>
